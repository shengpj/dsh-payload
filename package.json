{
  "name": "dsh-payload",
  "version": "1.3.0",
  "description": "DSH Web GUI plugin: inspect the exact payload sent to the model for every assistant reply.",
  "type": "module",
  "license": "MIT",
  "author": "shengpj",
  "homepage": "https://github.com/shengpj/dsh-payload#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shengpj/dsh-payload.git"
  },
  "bugs": {
    "url": "https://github.com/shengpj/dsh-payload/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "payload", "request-inspector", "debug"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "docs", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
