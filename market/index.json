      "title": {
        "en": "Payload inspector",
        "zh": "请求 JSON 查看器"
      },
      "description": {
        "en": "Adds a { } button to every assistant reply in the DSH Web GUI and shows the exact request that produced it: model, call parameters, messages, tools, and provider-reported token usage.",
